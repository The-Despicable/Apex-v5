#!/bin/sh
# APEX v5 — ADVISORY local hook. Not a control: -n and hooksPath changes bypass it.
# The real control is CI: see gate/audit-gate.yml and gate/verify-verdict.sh.
set -u
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
RE=$(cat "$DIR/risk-paths.re")
staged=$(git diff --cached --name-only 2>/dev/null || true)
if printf '%s\n' "$staged" | grep -Eq "$RE"; then
  echo "APEX v5 (advisory): risk paths staged — verifying signed verdict..." >&2
  sh "$DIR/verify-verdict.sh" || {
    echo "APEX v5: local gate blocked. Note: this hook is advisory; CI is the control." >&2
    exit 1
  }
fi
exit 0
